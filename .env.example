# Copy this file to .env and fill in the values you want to use.
# The app works with none of these set - AI falls back to keyword matching,
# and the WhatsApp webhook simply won't be reachable until Twilio/ngrok are configured.

PORT=3000

# Optional: enables real Claude-powered intent classification + Swahili translation.
# Get a free trial key (no credit card) at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Optional: without these, incoming WhatsApp replies still work via the webhook's TwiML
# response, but proactive alerts (tension changes, fact-checks) only log to the console
# instead of actually sending. Find these in the Twilio Console; TWILIO_WHATSAPP_FROM is
# your Sandbox number (shown there), formatted like "whatsapp:+14155238886".
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
